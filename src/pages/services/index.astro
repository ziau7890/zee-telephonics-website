---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services } from '../../lib/content';
---
<BaseLayout title="Services" description="Outsourced customer support, outbound calling, lead generation, appointment setting and back-office services from Zee Telephonics.">
  <PageHero
    eyebrow="Services"
    title="Support services built around your business"
    lead="Pick one service or combine several. We agree the scope, tools and reporting with you before any work starts."
    crumbs={[{ href: '/services/', label: 'Services' }]}
  />
  <section class="section">
    <div class="container grid grid--3">
      {services.map((s) => <div class="reveal"><ServiceCard service={s} /></div>)}
    </div>
  </section>
  <CtaBand title="Not sure which service fits?" text="Tell us what is taking up your team's time. We will suggest a starting point." />
</BaseLayout>
