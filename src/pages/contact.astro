---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../lib/content';
const { email, phone, hours, address } = site.contact;
const hasDetails = Boolean(email || phone || hours || address);
---
<BaseLayout title="Contact and quote" description={`Contact ${site.brandName} for a quote on outsourced customer support, outbound calling, lead generation and back-office services.`}>
  <PageHero
    eyebrow="Contact"
    title="Tell us what you need"
    lead="Share a few details and we will reply with next steps."
    crumbs={[{ href: '/contact/', label: 'Contact' }]}
  />
  <section class="section section--mist">
    <div class="container contact">
      <div class="contact__form">
        <noscript><p class="notice">You can send this form without JavaScript. You will be taken to a confirmation page after sending.</p></noscript>
        <p class="notice notice--error" hidden data-form-error></p>
        <LeadForm />
      </div>
      <aside class="contact__aside">
        <div class="card">
          <h2 class="h3">What happens next</h2>
          <ol class="next-steps">
            <li>We read your enquiry and reply by email.</li>
            <li>If it is a good fit, we arrange a discovery call.</li>
            <li>You receive a clear proposal with scope and pricing.</li>
          </ol>
        </div>
        {hasDetails && (
          <div class="card">
            <h2 class="h3">Other ways to reach us</h2>
            <ul class="contact__list">
              {email && <li><span>Email</span><a href={`mailto:${email}`}>{email}</a></li>}
              {phone && <li><span>Phone</span><a href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a></li>}
              {hours && <li><span>Hours</span>{hours}</li>}
              {address && <li><span>Address</span>{address}</li>}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  // When the form was sent without JavaScript and the server found a problem,
  // it sends the visitor back here with ?error=<code>.
  const box = document.querySelector<HTMLElement>('[data-form-error]');
  const code = new URLSearchParams(location.search).get('error');
  const text: Record<string, string> = {
    invalid: 'Some fields were missing or not valid. Please check the form and try again.',
    spam: 'Your enquiry could not be verified. Please try again.',
    rate: 'Too many enquiries were sent from your connection. Please try again in an hour.',
    server: 'Sorry, we could not send your enquiry right now. Please try again later.',
  };
  if (box && code && text[code]) {
    box.textContent = text[code];
    box.hidden = false;
  }
</script>

<style>
  .contact { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
  .contact__aside { display: grid; gap: 1.5rem; }
  .h3 { font-size: 1.2rem; }
  .next-steps { margin: 0; padding-left: 1.2rem; color: var(--ink-soft); display: grid; gap: 0.6rem; }
  .contact__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
  .contact__list span { display: block; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  .notice { background: var(--white); border-left: 4px solid var(--cyan-700); padding: 0.9rem 1.1rem; border-radius: 8px; }
  .notice--error { border-color: #c62828; background: #fdecea; color: #8a1c13; }
</style>
