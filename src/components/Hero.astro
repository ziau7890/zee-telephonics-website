---
import { site, home } from '../lib/content';
---
<section class="hero" data-hero>
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      {home.hero.eyebrow && <span class="eyebrow">{home.hero.eyebrow}</span>}
      <h1>{site.tagline.split('. ').map((part, i, arr) => (
        <span class:list={['hero__line', { 'hero__line--accent': i === arr.length - 1 }]}>{i < arr.length - 1 ? `${part}.` : part}</span>
      ))}</h1>
      <p class="lead">{home.hero.lead}</p>
      <div class="btn-row">
        <a class="btn" href="/contact/#quote">Get a quote</a>
        <a class="btn btn--outline" href="/services/">Explore services</a>
      </div>
    </div>
    <div class="hero__visual" data-hero-visual>
      <img class="hero__still" src="/hero-sphere.svg" alt="" width="800" height="800" fetchpriority="high" decoding="async" />
      <canvas class="hero__canvas" aria-hidden="true"></canvas>
    </div>
  </div>
</section>

<script>
  import { initHero } from '../scripts/hero-loader';
  const visual = document.querySelector<HTMLElement>('[data-hero-visual]');
  if (visual) initHero(visual);
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    color: var(--white);
    background: var(--navy-950);
    padding-block: clamp(7rem, 12vw, 9rem) clamp(3.5rem, 7vw, 6rem);
    min-height: min(100svh, 900px);
    display: flex;
    align-items: center;
  }
  .hero__bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(60% 70% at 78% 45%, rgb(30 94 255 / 0.28), transparent 70%),
      radial-gradient(40% 50% at 10% 100%, rgb(0 212 255 / 0.10), transparent 70%),
      var(--grad-night);
  }
  .hero__bg::after {
    content: '';
    position: absolute; inset: 0;
    background-image: linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(70% 60% at 50% 40%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(70% 60% at 50% 40%, #000 30%, transparent 80%);
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .hero h1 { font-size: clamp(2.4rem, 5.4vw, 4.4rem); max-width: 13ch; }
  .hero__line { display: block; }
  .hero__line--accent {
    background: linear-gradient(100deg, #ffffff 0%, var(--cyan-400) 60%, #6fa0ff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero .lead { color: var(--on-dark-soft); margin-bottom: 2rem; }

  .hero__visual { position: relative; aspect-ratio: 1; width: 100%; max-width: 620px; justify-self: end; }
  .hero__still, .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__still { animation: hero-float 9s ease-in-out infinite; transition: opacity 1.2s var(--ease); }
  .hero__canvas { opacity: 0; transition: opacity 1.2s var(--ease); }
  .hero__visual:global(.is-live) .hero__canvas { opacity: 1; }
  .hero__visual:global(.is-live) .hero__still { opacity: 0; }

  .hero__copy > * { animation: hero-rise 0.9s var(--ease) both; }
  .hero__copy > :nth-child(2) { animation-delay: 0.08s; }
  .hero__copy > :nth-child(3) { animation-delay: 0.16s; }
  .hero__copy > :nth-child(4) { animation-delay: 0.24s; }

  @keyframes hero-rise { from { opacity: 0; transform: translateY(16px); } }
  @keyframes hero-float { 50% { transform: translateY(-10px); } }

  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .hero__inner { grid-template-columns: 1fr; }
    .hero__visual { order: -1; max-width: 360px; justify-self: center; margin-bottom: -1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__still, .hero__copy > * { animation: none; }
  }
</style>
