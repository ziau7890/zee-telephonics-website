---
import { site, home } from '../lib/content';
---
<section class="hero" data-hero>
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      {home.hero.eyebrow && <span class="eyebrow">{home.hero.eyebrow}</span>}
      <h1>{site.tagline.split('. ').map((part, i, arr) => (
        <span class:list={['hero__line', { accent: i === arr.length - 1 }]}>{i < arr.length - 1 ? `${part}.` : part}</span>
      ))}</h1>
      <p class="lead">{home.hero.lead}</p>
      <div class="btn-row">
        <a class="btn" href="/contact/#quote">Get a quote <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a class="btn btn--light" href="/services/">Explore services</a>
      </div>
    </div>
    <div class="hero__stage">
      <span class="hero__shape hero__shape--a" aria-hidden="true"></span>
      <span class="hero__shape hero__shape--b" aria-hidden="true"></span>
      <span class="hero__shape hero__shape--c" aria-hidden="true"></span>
      <div class="hero__panel">
        <div class="hero__visual" data-hero-visual>
          <img class="hero__still" src="/hero-sphere.svg" alt="" width="800" height="800" fetchpriority="high" decoding="async" />
          <canvas class="hero__canvas" aria-hidden="true"></canvas>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHero } from '../scripts/hero-loader';
  const visual = document.querySelector<HTMLElement>('[data-hero-visual]');
  if (visual) initHero(visual);
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--background);
    padding-block: clamp(7.5rem, 12vw, 9.5rem) clamp(3.5rem, 7vw, 6rem);
  }
  .hero__bg { position: absolute; inset: 0; background: var(--grad-hero); }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .hero h1 { font-size: clamp(2.4rem, 5.2vw, 4.2rem); max-width: 14ch; letter-spacing: -0.02em; }
  .hero__line { display: block; }
  .hero .lead { color: var(--ink-soft); margin-bottom: 2rem; max-width: 34rem; }

  .hero__stage { position: relative; justify-self: end; width: 100%; max-width: 560px; }
  .hero__panel {
    position: relative;
    border-radius: 2rem;
    background:
      radial-gradient(70% 60% at 70% 30%, rgb(30 94 255 / 0.35), transparent 70%),
      radial-gradient(50% 50% at 15% 100%, rgb(0 212 255 / 0.18), transparent 70%),
      var(--navy-950);
    box-shadow: var(--shadow-lift), 0 40px 80px -30px rgb(10 22 48 / 0.45);
    overflow: hidden;
    padding: clamp(0.5rem, 2vw, 1.25rem);
  }
  .hero__visual { position: relative; aspect-ratio: 1; width: 100%; }
  .hero__still, .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__still { animation: hero-float 9s ease-in-out infinite; transition: opacity 1.2s var(--ease); }
  .hero__canvas { opacity: 0; transition: opacity 1.2s var(--ease); }
  .hero__visual:global(.is-live) .hero__canvas { opacity: 1; }
  .hero__visual:global(.is-live) .hero__still { opacity: 0; }

  .hero__shape { position: absolute; border-radius: 14px; z-index: 1; animation: hero-bob 8s ease-in-out infinite; }
  .hero__shape--a { width: 64px; height: 64px; top: -22px; left: -26px; background: linear-gradient(135deg, var(--cyan-400), #6fe4ff); box-shadow: 0 16px 30px -12px rgb(0 160 200 / 0.6); transform: rotate(-12deg); }
  .hero__shape--b { width: 44px; height: 44px; bottom: 18%; right: -20px; background: linear-gradient(135deg, var(--blue-500, #1e5eff), #6fa0ff); box-shadow: 0 16px 30px -12px rgb(30 94 255 / 0.6); transform: rotate(14deg); animation-delay: -3s; }
  .hero__shape--c { width: 26px; height: 26px; bottom: -12px; left: 22%; border-radius: 50%; background: var(--white); border: 6px solid var(--cyan-400); animation-delay: -5s; }

  .hero__copy > * { animation: hero-rise 0.9s var(--ease) both; }
  .hero__copy > :nth-child(2) { animation-delay: 0.08s; }
  .hero__copy > :nth-child(3) { animation-delay: 0.16s; }
  .hero__copy > :nth-child(4) { animation-delay: 0.24s; }

  @keyframes hero-rise { from { opacity: 0; transform: translateY(16px); } }
  @keyframes hero-float { 50% { transform: translateY(-8px); } }
  @keyframes hero-bob { 50% { translate: 0 -10px; } }

  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__stage { justify-self: center; max-width: 420px; margin-top: 0.5rem; }
    .hero__shape--a { width: 46px; height: 46px; top: -14px; left: -10px; }
    .hero__shape--b { right: -8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__still, .hero__copy > *, .hero__shape { animation: none; }
  }
</style>
