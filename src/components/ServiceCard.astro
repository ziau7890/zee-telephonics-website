---
import Icon from './Icon.astro';
import type { Service } from '../lib/content';
interface Props { service: Service }
const { service } = Astro.props;
---
<a class="service-card card" href={`/services/${service.slug}/`}>
  <span class="icon-badge"><Icon name={service.icon} /></span>
  <h3>{service.title}</h3>
  <p>{service.summary}</p>
  <span class="service-card__more">Learn more <Icon name="arrow" size={18} /></span>
</a>
<style>
  .service-card {
    display: flex; flex-direction: column;
    color: inherit; text-decoration: none;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s;
    transform: perspective(900px) rotateX(0) translateY(0);
  }
  .service-card p { flex: 1; }
  .service-card:hover {
    color: inherit;
    border-color: rgb(0 122 153 / 0.45);
    transform: perspective(900px) rotateX(2deg) translateY(-4px);
    box-shadow: 0 2px 4px rgb(10 22 48 / 0.06), 0 22px 44px rgb(10 22 48 / 0.14);
  }
  .service-card__more { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 1.2rem; font-weight: 600; color: var(--cyan-700); font-size: 0.95rem; }
  .service-card:hover .service-card__more { color: var(--blue-500); }
  @media (prefers-reduced-motion: reduce) { .service-card:hover { transform: none; } }
</style>
