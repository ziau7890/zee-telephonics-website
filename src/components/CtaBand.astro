---
interface Props { title?: string; text?: string }
const {
  title = 'Tell us what you want to hand over',
  text = 'Share a few details about your business and the support you need. We will reply with next steps.',
} = Astro.props;
---
<section class="section cta-band">
  <div class="container">
    <div class="cta-panel cta-band__inner reveal">
      <div>
        <h2>{title}</h2>
        <p class="lead">{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--cyan" href="/contact/#quote">Get a quote <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a class="btn btn--outline" href="/services/">Explore services</a>
      </div>
    </div>
  </div>
</section>
<style>
  .cta-band__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; }
  .cta-band h2 { max-width: 20ch; }
  .cta-band .lead { margin-bottom: 0; }
</style>
