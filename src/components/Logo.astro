---
/* Starter wordmark. Replace with the final logo when it exists. */
import { site } from '../lib/content';
interface Props { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props;
const id = `zg-${tone}`;
---
<span class={`logo logo--${tone}`}>
  <svg class="logo__mark" width="36" height="36" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#1E5EFF" />
        <stop offset="1" stop-color="#00D4FF" />
      </linearGradient>
    </defs>
    <rect x="1" y="1" width="38" height="38" rx="11" fill="#0A1630" stroke={`url(#${id})`} stroke-width="1.5" />
    <path d="M12 12.5h16L12.5 27.5H28" fill="none" stroke={`url(#${id})`} stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="12" cy="12.5" r="2.3" fill="#00D4FF" />
    <circle cx="28" cy="27.5" r="2.3" fill="#00D4FF" />
  </svg>
  <span class="logo__text">{site.brandName.replace(/\s*Telephonics$/, '')}<span class="logo__accent"> Telephonics</span></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-head); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.01em; white-space: nowrap; }
  .logo--light { color: var(--white); }
  .logo--dark { color: var(--navy-950); }
  .logo__accent { font-weight: 500; opacity: 0.85; }
  .logo__mark { flex: none; }
</style>
