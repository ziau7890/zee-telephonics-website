---
/*
 * Zee Telephonics logo: a round "ZT" badge inside an orbit ring with a signal dot,
 * followed by an uppercase wordmark. Original artwork in the brand colours.
 */
interface Props { tone?: 'light' | 'dark'; showText?: boolean }
const { tone = 'light', showText = true } = Astro.props;
const ring = tone === 'light' ? '#FFFFFF' : '#0A1630';
const badge = tone === 'light' ? '#FFFFFF' : '#0A1630';
const letters = tone === 'light' ? '#0A1630' : '#FFFFFF';
---
<span class={`logo logo--${tone}`}>
  <svg class="logo__mark" width="46" height="46" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <!-- orbit ring with three markers -->
    <circle cx="24" cy="24" r="22" fill="none" stroke={ring} stroke-opacity="0.85" stroke-width="1.6" />
    <path d="M24 0.8v4.2M0.8 24h4.2M43 24h4.2" stroke={ring} stroke-opacity="0.85" stroke-width="1.6" />
    <!-- badge -->
    <circle cx="24" cy="24" r="16.5" fill={badge} />
    <text x="24" y="29.2" text-anchor="middle" font-family="Sora Variable, Segoe UI, sans-serif" font-weight="700" font-size="14.5" letter-spacing="-0.5" fill={letters}>ZT</text>
    <!-- signal dot on the orbit -->
    <circle cx="39.6" cy="39.6" r="4" fill="#00D4FF" stroke={tone === 'light' ? '#0A1630' : '#FFFFFF'} stroke-width="1.4" />
  </svg>
  {showText && <span class="logo__text">ZEE <span class="logo__accent">TELEPHONICS</span></span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.7rem; font-family: var(--font-head); font-weight: 700; font-size: 1.12rem; letter-spacing: 0.04em; white-space: nowrap; }
  .logo--light { color: var(--white); }
  .logo--dark { color: var(--navy-950); }
  .logo__accent { font-weight: 600; }
  .logo--light .logo__accent { color: #d6f6ff; }
  .logo__mark { flex: none; overflow: visible; }
</style>
